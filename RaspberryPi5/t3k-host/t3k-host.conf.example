# t3k-host start settings. Copy to ~/.config/t3k-host/t3k-host.conf.
# One "key = value" per line; the keys are the command-line options without
# "--" (see t3k-host --help). Options given on the command line win.

# Audio
device = Scarlett
device-wait = 30
block = 32
input-mode = left

# Front panel
lcd = ili9341
# Backlight on a GPIO instead of 3.3 V: dark while the host is not running
# lcd-backlight = 13
encoder = 5,6,26
# Look of the screen: typeface (installed font family) and navigation colour
ui-font = Barlow Condensed
ui-accent = amber

# Seconds without input until the screen shows only the preset, 0 = never
idle-view = 10
# Optional second encoder: the preset's volume (or "models")
# model-encoder = 18,19,20
# model-encoder-role = volume

# Sound at start: a preset, or a local tone when no preset is set.
# The host updates the preset line whenever another preset is loaded.
tone = ~/tones/Boosted-6505+-A2-Chugs-FullRig.nam
preset =

# MIDI controller on the interface's MIDI input (see README, MIDI)
# midi-input = Scarlett
# midi-tuner-cc = 64
# midi-cc = 66:presetNext

# CPU/xrun report in the log every n seconds, 0 = off
status = 0
